{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Run schema-analyzer dentists",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/analysis-dean/schema-analyzer.py",
            "args": [
                "--dentists"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Run schema-analyzer foreign-keys",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/analysis-dean/schema-analyzer.py",
            "args": [
                "--foreign-keys"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Run schema-analyzer offices",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/analysis-dean/schema-analyzer.py",
            "args": [
                "--offices"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Run column-references",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/analysis-dean/column-references.py",
            "args": [
                "-sc",
                "${workspaceFolder}/analysis-dean/dentist-columns.json",
                "-fk",
                "${workspaceFolder}/analysis-dean/foreign-keys.json",
                "--out",
                "${workspaceFolder}/analysis-dean/dentist-references.json"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Debug NetworkDiagram",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npx",
            "runtimeArgs": [
                "astro",
                "dev"
            ],
            "port": 9229,
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}
